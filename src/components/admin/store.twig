<br>
<br>
<div class="mx-5 mt-5 mb-4">
    <div class="d-flex justify-content-between">
        <h5>Lojas <i class="bi bi-tag"></i></h5>
        <button c-id="new-store" class="btn-add-product">Adicionar loja</button>
    </div>
    
    <div class="my-table mt-3">
        <div class="row mx-1 p-1">
            <div class="col-lg-3">
                <label class="mt-1"><b>Loja</b></label>
            </div>
            
            <div class="col-lg-2">
                <label class="mt-1"><b>Idioma</b></label>
            </div>
            <div class="col-lg-2">
                <label class="mt-1"><b>Moeda</b></label>
            </div>
            <div class="col-lg-2">
                
            </div>
            <div class="col-lg-3">
                <label class="mt-1"><b>Status</b></label>
                
            </div>
        </div>

        <div c-id="model-store" id="" class="col-lg-12 none">
            <div  class="row model-table p-2">
                <div class="col-lg-3">
                    <img style="width:49px!important;height: fit-content;" class="ms-2 img-fluid" src=""> 
                    <a class="ms-2"></a>
                </div>
                <div class="col-lg-2">
                    <label c-id="idioma" class="ms-2"></label>
                </div>
                <div class="col-lg-2">
                    <label c-id="moeda" class="ms-2"></label>
                </div>
                <div class="col-lg-2">
                    
                </div>
                <div class="col-lg-3">
                    <div class="row-actions"><div class="form-check form-switch">
                        <input c-id="status" class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked">
                    </div><button c-id="btn-delete" class="btn-delete" title="Excluir loja"><i class="bi bi-trash3"></i></button></div>
                </div>
            </div>
        </div>

        <div c-id="all-stores" class="row">
            {% for store in stores %}

                <div c-id="model-store" id="{{store._id}}" class="col-lg-12">
                    <div  class="row model-table p-2">
                        <div class="col-lg-3">
                            <img class="ms-2 img-fluid" style="width:49px!important;height: fit-content;" src="{{store.logo |default('https://gravitec.net/pt/empty.jpg')}}"> 
                            <a class="ms-2">{{store.name}}</a>
                        </div>
                        <div class="col-lg-2">
                            <label c-id="idioma" class="ms-2">{{store.idioma}}</label>
                        </div>
                        <div class="col-lg-2">
                            <label c-id="moeda" class="ms-2">{{store.moeda}}</label>
                        </div>
                        <div class="col-lg-2">
                            
                        </div>
                        <div class="col-lg-3">
                            <div class="row-actions"><div class="form-check form-switch">
                                <input c-id="status" class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked" 
                                {% if store.status == true %}
                                    checked
                                {% endif %}
                                
                                >
                            </div><button c-id="btn-delete" class="btn-delete" title="Excluir loja"><i class="bi bi-trash3"></i></button></div>
                        </div>
                        
                    </div>
                </div>

                            
            {% endfor %}
        </div>
    </div>
    
</div>

<div class="d-flex justify-content-center z-index-spinner">
    <div c-id="loading-center" class="spinner-border style-spinner none" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>


<div c-id="modal-store" class="modal fade modal-product-style" tabindex="-1" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-fullscreen">
    <div c-id="form" class="modal-content bk-modal">
      <div class="modal-header rm-border">
        <div class="container-fluid px-3">
            <h1 class="modal-title fs-5"><i class="bi bi-tag me-1"></i><b c-id="name-store"></b><span class="modal-title-fallback">Nova loja</span></h1>
            <p class="modal-subtitle">Identidade, países atendidos, visual e CSS da vitrine. Templates e políticas ficam nos botões ao lado.</p>
        </div>
        <button c-id="open-policies" class="btn-modal me-2 none">Políticas</button>
        <button c-id="open-template" class="btn-modal me-2 none">Editar template</button>
        <button c-id="close-modal" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body">
        <div class="container-xl">
            <div class="layout-switch layout-switch-top" c-id="visual-layout">
                <span class="layout-switch-label"><i class="bi bi-layers"></i> Layout</span>
                <input type="radio" class="btn-check" name="visual_layout" id="visual-layout-first" value="first" data-keep="1" checked>
                <label class="btn btn-sm" for="visual-layout-first">First</label>
                <input type="radio" class="btn-check" name="visual_layout" id="visual-layout-second" value="second" data-keep="1">
                <label class="btn btn-sm" for="visual-layout-second">Second</label>
                <p class="modal-section-hint" c-id="visual-hint">Título, mensagem do topo, cores, logo, banners e CSS pertencem ao layout selecionado. Nome, idioma, moeda, países e atendimento valem para a loja inteira.</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-7">
                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-info-circle"></i> Identidade</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Nome</label>
                                <input c-id="name" type="text" class="form-control" placeholder="Galeries Lafayette">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Idioma</label>
                                <select c-id="idioma" class="form-control">
                                    {% for idi_ in options_idioma %}
                                        <option value="{{idi_.value}}">{{idi_.key}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Moeda base</label>
                                <select c-id="moeda" class="form-control">
                                    {% for moeda_ in options_moeda %}
                                        <option value="{{moeda_.value}}">{{moeda_.key}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-globe"></i> Países atendidos <span c-id="country-count" class="chip">0</span></h6>
                        <p class="modal-section-hint">O primeiro país marcado define a moeda e o checkout padrão. Visitantes de outros países caem no filtro (layout second).</p>
                        <input c-id="country-filter" type="text" class="form-control mb-2" placeholder="Filtrar país...">
                        <div c-id="country" class="country-grid">
                            {% for country_ in options_country %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="{{country_.value}}" id="country-{{country_.value}}">
                                    <label class="form-check-label" for="country-{{country_.value}}">{{country_.key}} <small>{{country_.value}}</small></label>
                                </div>
                            {% endfor %}
                        </div>
                    </section>

                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-chat-dots"></i> Atendimento (chat do pedido)</h6>
                        <p class="modal-section-hint">A assistente responde com os dados reais do pedido na Shopify e as políticas da loja. Cupom e instruções são opcionais.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nome da assistente</label>
                                <input c-id="support_assistant" type="text" class="form-control" placeholder="Padrão por idioma (Élodie, Emily, Lena, Emma)">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cupom de fidelidade</label>
                                <input c-id="support_loyalty" type="text" class="form-control" placeholder="ex.: FIDELITE">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Instruções extras para a assistente</label>
                                <textarea c-id="support_instructions" rows="3" class="form-control" placeholder="ex.: prazo de entrega habitual, horário do suporte, o que nunca prometer..."></textarea>
                            </div>
                        </div>
                    </section>

                    <section class="modal-section layout-scoped">
                        <h6 class="modal-section-title"><i class="bi bi-window"></i> Título no navegador <span class="layout-tag" c-id="layout-tag">first</span></h6>
                        <p class="modal-section-hint">Aparece na aba do navegador e no cabeçalho. Vazio: o first usa o nome da loja e o second usa o título do first.</p>
                        <input c-id="title" type="text" class="form-control" placeholder="Nome da loja">
                    </section>

                    <section class="modal-section layout-scoped">
                        <h6 class="modal-section-title"><i class="bi bi-palette"></i> Mensagem do topo e cores <span class="layout-tag" c-id="layout-tag">first</span></h6>
                        <p class="modal-section-hint" c-id="colors-hint">Valores do layout first (o second herda o que não definir).</p>
                        <button type="button" c-id="reset-colors" class="btn-modal btn-modal-sm mb-3 none"><i class="bi bi-arrow-counterclockwise"></i> Herdar mensagem e cores do first</button>
                        <div class="color-grid">
                            <div class="color-group">
                                <div class="color-group-title">Mensagem no topo</div>
                                <input c-id="message_top" class="form-control mb-2" placeholder="Frete grátis acima de 50€">
                                <div class="color-fields">
                                    <label class="color-field"><input type="color" c-id="color_message" class="form-control"><span>Texto</span></label>
                                    <label class="color-field"><input type="color" c-id="bk_message" class="form-control"><span>Fundo</span></label>
                                </div>
                            </div>
                            <div class="color-group">
                                <div class="color-group-title">Botão da página do produto</div>
                                <div class="color-fields">
                                    <label class="color-field"><input type="color" c-id="color_btn_product" class="form-control"><span>Texto</span></label>
                                    <label class="color-field"><input type="color" c-id="bk_btn_product" class="form-control"><span>Fundo</span></label>
                                </div>
                            </div>
                            <div class="color-group">
                                <div class="color-group-title">Botão de checkout (carrinho)</div>
                                <div class="color-fields">
                                    <label class="color-field"><input type="color" c-id="color_btn_checkout" class="form-control"><span>Texto</span></label>
                                    <label class="color-field"><input type="color" c-id="bk_btn_checkout" class="form-control"><span>Fundo</span></label>
                                </div>
                            </div>
                            <div class="color-group">
                                <div class="color-group-title">Botão adicionar mais itens (carrinho)</div>
                                <div class="color-fields">
                                    <label class="color-field"><input type="color" c-id="color_btn_add_items" class="form-control"><span>Texto</span></label>
                                    <label class="color-field"><input type="color" c-id="bk_btn_add_items" class="form-control"><span>Fundo</span></label>
                                </div>
                            </div>
                            <div class="color-group">
                                <div class="color-group-title">Rodapé</div>
                                <div class="color-fields">
                                    <label class="color-field"><input type="color" c-id="color_footer" class="form-control"><span>Texto</span></label>
                                    <label class="color-field"><input type="color" c-id="bk_footer" class="form-control"><span>Fundo</span></label>
                                </div>
                            </div>
                            <div class="color-group">
                                <div class="color-group-title">Ícones</div>
                                <div class="color-fields">
                                    <label class="color-field"><input type="color" c-id="color_icons" class="form-control"><span>Ícones</span></label>
                                    <label class="color-field"><input type="color" c-id="color_n_items_cart" class="form-control"><span>Fundo do contador do carrinho</span></label>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-5">
                    <section class="modal-section layout-scoped">
                        <h6 class="modal-section-title"><i class="bi bi-image"></i> Logo <span class="layout-tag" c-id="layout-tag">first</span></h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="image-picker">
                                    <label class="dropzone dropzone-sm" c-id="dropzone-logo">
                                        <input c-id="logo" type="file" accept="image/*" class="dropzone-input">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                        <span class="dropzone-title">Escolher logo</span>
                                    </label>
                                    <div class="ai-bar" c-id="ai-bar-logo" data-aspect="1:1">
                                <i class="bi bi-stars"></i>
                                <input c-id="ai-prompt" type="text" class="form-control" placeholder="Ou gere o logo com IA...">
                                <button type="button" c-id="ai-generate" class="btn-modal">Gerar</button>
                            </div>
                                    <div class="image-picker-preview none">
                                        <img c-id="img-logo" alt="">
                                        <span class="inherited-badge">herdado do first</span>
                                        <button type="button" c-id="remove-img" title="Remover"><i class="bi bi-trash3"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div c-id="position-logo">
                                    <label class="form-label">Posição do logo</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="position" value="left" id="position-left">
                                        <label class="form-check-label" for="position-left">Esquerda</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="position" value="center" id="position-center">
                                        <label class="form-check-label" for="position-center">Centralizado</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="modal-section layout-scoped">
                        <h6 class="modal-section-title"><i class="bi bi-images"></i> Banners <span class="layout-tag" c-id="layout-tag">first</span></h6>
                        <p class="modal-section-hint">Usados pelo template da home como banner_1, banner_2 e banner_3, no layout selecionado.</p>
                        <div class="row g-3">
                            {% for n in 1..3 %}
                            <div class="col-md-4">
                                <div class="image-picker">
                                    <label class="dropzone dropzone-sm" c-id="dropzone-banner_{{n}}">
                                        <input c-id="banner_{{n}}" type="file" accept="image/*" class="dropzone-input">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                        <span class="dropzone-title">Banner {{n}}</span>
                                    </label>
                                    <div class="ai-bar ai-bar-sm" c-id="ai-bar-banner_{{n}}" data-aspect="16:9">
                                        <i class="bi bi-stars"></i>
                                        <input c-id="ai-prompt" type="text" class="form-control" placeholder="Gerar com IA...">
                                        <button type="button" c-id="ai-generate" class="btn-modal">Gerar</button>
                                    </div>
                                    <div class="image-picker-preview none">
                                        <img c-id="banner-{{n}}" alt="">
                                        <span class="inherited-badge">herdado do first</span>
                                        <button type="button" c-id="remove-img" title="Remover"><i class="bi bi-trash3"></i></button>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </section>

                    <section class="modal-section layout-scoped">
                        <h6 class="modal-section-title"><i class="bi bi-filetype-css"></i> CSS da vitrine <span class="layout-tag" c-id="layout-tag">first</span></h6>
                        <p class="modal-section-hint">Injetado em todas as páginas da loja no layout selecionado. No second, vazio usa o CSS do first.</p>
                        <div id="editor" style="width:100%;height:360px;"></div>
                    </section>
                </div>
            </div>
        </div>
      </div>
      <div class="modal-footer rm-border">
        <div c-id="loading-btn" class="spinner-border none" role="status"><span class="visually-hidden">Loading...</span></div>
        <button c-id="save-store" class="btn-modal">Salvar</button>
      </div>
    </div>
  </div>
</div>

<div c-id="modal-template" class="modal fade modal-product-style" tabindex="-2" aria-labelledby="exampleModalFullscreenLabel"  aria-modal="true" role="dialog">
  <div class="modal-dialog modal-fullscreen" >
    <div class="modal-content bk-modal" >
      <div class="modal-header rm-border" >
       
        <button c-id="close-modal-template" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body" >
        <div style="height: 94%;">
            <div style="height: 94%;" class="row mx-2">
                <div class="col-lg-2">
                    <h5><b>Layout</b></h5>
                    <select c-id="layout-file" class="form-control mb-3">
                        {% for layout_ in options_layout %}
                            <option value="{{layout_.value}}">{{layout_.key}}</option>
                        {% endfor %}
                    </select>
                    <h5><b>Arquivos</b></h5>
                    {% for file in files %}
                        <div id="{{file.id}}" c-id="model-file" class="div-file">
                            <p class="p-2">{{file.name}}</p>
                        </div>
                    {% endfor %}
                    
                </div>
                <div class="col-lg-10">
                    <div id="edit-twig" style="width:100%;height:100%;"></div>
                </div>
            </div>
        </div>
        <button c-id="save-template" class="btn-modal mt-4 float-end">Salvar</button>
        <div class="clearfix">
            <div c-id="loading-btn" class="spinner-border float-end mt-4 none" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        
      </div>
    
    </div>
  </div>
</div>

<div c-id="modal-policies" class="modal fade modal-product-style" tabindex="-1" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content bk-modal">
      <div class="modal-header rm-border">
        <div class="container">
            <h1 class="modal-title fs-5 ms-3">Políticas da loja</h1>
        </div>
        <button c-id="close-modal-policies" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body">
        <div class="row mx-2">
            <div class="col-lg-2">
                <h5><b>Políticas</b></h5>
                {% for policy in policy_files %}
                    <div id="{{policy.id}}" c-id="model-policy" class="div-file">
                        <p class="p-2">{{policy.name}}</p>
                    </div>
                {% endfor %}
                <p class="metric-sub mt-3">Sem texto próprio, a loja usa o padrão do país (ou do idioma). Salvar com título e texto vazios volta ao padrão.</p>
            </div>
            <div class="col-lg-10">
                <div class="form-default">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <span c-id="policy-source" class="policy-source"></span>
                        <div>
                            <button c-id="reset-policy" class="btn-modal me-2">Restaurar padrão</button>
                            <button c-id="save-policy" class="btn-modal">Salvar</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input c-id="policy-title" type="text" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Texto</label>
                        <textarea id="policy-editor" c-id="policy-editor"></textarea>
                    </div>
                </div>
                <br>
                <br>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>
