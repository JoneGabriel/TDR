

<br>
<br>
<div class="mx-5 mt-5 mb-4">
    <div class="d-flex justify-content-between">
        <h5>Shopifys <i class="bi bi-shop"></i></i></h5>
        <button c-id="new-store" class="btn-add-product">Adicionar shopify</button>
    </div>
    
    <div class="my-table mt-3">
        <div class="row mx-1 p-1">
            <div class="col-lg-4">
                <label class="mt-1"><b>Shopify</b></label>
            </div>
            <div class="col-lg-4">
                <label class="mt-1"><b>Client ID</b></label>
            </div>
            <div class="col-lg-4">
                <label class="mt-1"><b>Token Admin (legado)</b></label>
            </div>
        </div>

        <div c-id="model-store" id="" class="col-lg-12 none">
            <div  class="row model-table p-2">
                <div class="col-lg-4"> 
                    <a class="ms-2"></a>
                </div>
                <div class="col-lg-4">
                    <label c-id="client_id" class="ms-2"></label>
                </div>
                <div class="col-lg-4">
                    <div class="row-actions"><label c-id="admin" class="ms-2"></label><button c-id="btn-delete" class="btn-delete" title="Excluir Shopify"><i class="bi bi-trash3"></i></button></div>
                </div>
            </div>
        </div>

        <div c-id="all-store" class="row">
            {% for loja in shopifys %}

                <div c-id="model-store" id="{{loja._id}}" class="col-lg-12">
                    <div  class="row model-table p-2">
                        <div class="col-lg-4">
                            <a class="ms-2">{{loja.url}}</a>
                        </div>
                        <div class="col-lg-4">
                            <label class="ms-2">{{loja.client_id}}</label>
                        </div>
                        <div class="col-lg-4">
                            <div class="row-actions"><label class="ms-2">{{loja.token_admin}}</label><button c-id="btn-delete" class="btn-delete" title="Excluir Shopify"><i class="bi bi-trash3"></i></button></div>
                        </div>
                    </div>
                </div>

                            
            {% endfor %}
        </div>
    </div>
    
</div>


<div c-id="modal-store" class="modal fade" tabindex="-1" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div c-id="form" class="modal-content bk-modal">
      <div class="modal-header rm-border">
        <div class="container-fluid px-3">
            <h1 class="modal-title fs-5"><i class="bi bi-shop me-1"></i><b c-id="name-store"></b><span class="modal-title-fallback">Nova Shopify</span></h1>
            <p class="modal-subtitle">Credenciais da loja Shopify que fornece produtos, variantes, preços e checkout.</p>
        </div>
        <button c-id="close-modal" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
            <div class="col-lg-4">
                <section class="modal-section h-100">
                    <h6 class="modal-section-title"><i class="bi bi-link-45deg"></i> Loja</h6>
                    <div class="mb-3">
                        <label class="form-label">URL</label>
                        <input c-id="url" type="text" class="form-control" placeholder="hjauds-08.myshopify.com">
                    </div>
                    <div>
                        <label class="form-label">Loja do TDR</label>
                        <select c-id="store-config" class="form-select"></select>
                    </div>
                </section>
            </div>
            <div class="col-lg-4">
                <section class="modal-section h-100">
                    <h6 class="modal-section-title"><i class="bi bi-key"></i> App do Dev Dashboard</h6>
                    <p class="modal-section-hint">Client credentials: o token Admin é gerado e renovado automaticamente.</p>
                    <div class="mb-3">
                        <label class="form-label">Client ID</label>
                        <input c-id="client_id" type="text" class="form-control">
                    </div>
                    <div>
                        <label class="form-label">Client Secret</label>
                        <input c-id="client_secret" type="password" class="form-control" autocomplete="new-password">
                    </div>
                </section>
            </div>
            <div class="col-lg-4">
                <section class="modal-section h-100">
                    <h6 class="modal-section-title"><i class="bi bi-shield-check"></i> Tokens</h6>
                    <div class="mb-3">
                        <label class="form-label">Token Storefront <small>(opcional, gerado automaticamente)</small></label>
                        <input c-id="token_storefront" type="text" class="form-control">
                    </div>
                    <div>
                        <label class="form-label">Token Admin <small>(apenas apps legados)</small></label>
                        <input c-id="token_admin" type="text" class="form-control">
                    </div>
                </section>
            </div>
        </div>
      </div>
      <div class="modal-footer rm-border">
        <div c-id="loading-btn" class="spinner-border none" role="status"><span class="visually-hidden">Loading...</span></div>
        <button c-id="save-store" class="btn-modal">Salvar</button>
      </div>
    </div>
  </div>
</div>
