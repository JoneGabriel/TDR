<div class="mx-5 mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <h5>Análises <i class="bi bi-bar-chart"></i></h5>
        <div class="metrics-filters">
            <input c-id="start" value="{{now}}" type="date" class="form-control input-style" max="{{max}}" title="início">
            <span class="metrics-filters-sep">até</span>
            <input c-id="end" value="{{now}}" type="date" class="form-control input-style" max="{{max}}" title="fim">
            <select class="form-control input-style" c-id="domain">
                <option value="">Todos os domínios</option>
                {% for domain_ in domains %}
                    <option value="{{domain_.domain}}">{{domain_.domain}}</option>
                {% endfor %}
            </select>
            <button c-id="filter" class="btn-add-product">Atualizar</button>
        </div>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-lg-3">
            <div class="area-metric realtime p-3 h-100">
                <p><b>Usuários agora</b> <span class="realtime-dot" title="últimos 5 minutos, atualiza a cada 10s"></span></p>
                <h4 c-id="rt-active">0</h4>
                <div class="metric-sub">
                    <span c-id="rt-mobile">0</span> mobile ·
                    <span c-id="rt-passed">0</span> liberados ·
                    <span c-id="rt-filtered">0</span> filtrados ·
                    <span c-id="rt-cart">0</span> com carrinho
                </div>
                <div c-id="rt-pages" class="mini-list mt-3"></div>
                <div c-id="rt-domains" class="mini-list mt-2"></div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="row g-3">
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Sessões</span>
                        <span c-id="kpi-sessions" class="kpi-value">0</span>
                        <span class="kpi-sub"><span c-id="kpi-pageviews">0</span> pageviews · <span c-id="kpi-ppv">0</span> por sessão</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Adicionaram ao carrinho</span>
                        <span c-id="kpi-cart" class="kpi-value">0</span>
                        <span class="kpi-sub"><span c-id="kpi-cart-rate">0</span>% das sessões</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Foram ao checkout</span>
                        <span c-id="kpi-checkout" class="kpi-value">0</span>
                        <span class="kpi-sub"><span c-id="kpi-checkout-rate">0</span>% das sessões · <span c-id="kpi-checkout-cart-rate">0</span>% dos carrinhos</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Rejeição</span>
                        <span class="kpi-value"><span c-id="kpi-bounce">0</span>%</span>
                        <span class="kpi-sub">sessões com uma única página</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Liberados / filtrados</span>
                        <span class="kpi-value"><span c-id="kpi-passed">0</span> <span class="kpi-sep">/</span> <span c-id="kpi-filtered">0</span></span>
                        <span class="kpi-sub">layout first / layout second</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Mobile</span>
                        <span class="kpi-value"><span c-id="kpi-mobile">0</span>%</span>
                        <span class="kpi-sub"><span c-id="kpi-mobile-n">0</span> sessões</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Bots ignorados</span>
                        <span c-id="kpi-bots" class="kpi-value">0</span>
                        <span class="kpi-sub">fora de todas as contagens</span>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="kpi-tile">
                        <span class="kpi-label">Período</span>
                        <span c-id="kpi-range" class="kpi-value kpi-value-sm">hoje</span>
                        <span c-id="kpi-range-sub" class="kpi-sub">por hora</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3 g-3">
        <div class="col-lg-8">
            <div class="area-metric p-3">
                <p><b>Sessões ao longo do tempo</b> <span c-id="series-granularity" class="metric-tag"></span></p>
                <div id="chart_div" style="height:280px;"></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="area-metric p-3 h-100">
                <p><b>Funil</b></p>
                <div class="funnel">
                    <div class="funnel-row">
                        <span class="funnel-label">Sessões</span>
                        <div class="funnel-bar"><div c-id="funnel-sessions" class="funnel-fill" style="width:0%"></div></div>
                        <span c-id="funnel-sessions-value" class="funnel-value">0</span>
                    </div>
                    <div class="funnel-row">
                        <span class="funnel-label">Carrinho</span>
                        <div class="funnel-bar"><div c-id="funnel-cart" class="funnel-fill funnel-fill-2" style="width:0%"></div></div>
                        <span c-id="funnel-cart-value" class="funnel-value">0</span>
                    </div>
                    <div class="funnel-row">
                        <span class="funnel-label">Checkout</span>
                        <div class="funnel-bar"><div c-id="funnel-checkout" class="funnel-fill funnel-fill-3" style="width:0%"></div></div>
                        <span c-id="funnel-checkout-value" class="funnel-value">0</span>
                    </div>
                </div>
                <p class="metric-sub mt-3 mb-0">Cada etapa conta sessões únicas. Carrinho e checkout são marcados uma vez por sessão.</p>
            </div>
        </div>
    </div>

    <div class="row mt-3 g-3">
        <div class="col-lg-5">
            <div class="area-metric p-3 h-100">
                <p><b>Páginas mais vistas</b></p>
                <div c-id="top-pages" class="metric-table"></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="area-metric p-3 h-100">
                <p><b>Países</b></p>
                <div c-id="top-countries" class="metric-table"></div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="area-metric p-3 h-100">
                <p><b>Dispositivos</b></p>
                <div c-id="devices" class="metric-table"></div>
            </div>
        </div>
    </div>
</div>
