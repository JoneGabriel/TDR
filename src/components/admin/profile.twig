<div class="mx-5 mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h5>Meus dados <i class="bi bi-person-circle"></i></h5>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-lg-6 col-xl-5">
            <section class="modal-section profile-section">
                <h6 class="modal-section-title"><i class="bi bi-person-badge"></i> Perfil</h6>
                <p class="modal-section-hint">Usuário de acesso, papel e conta não mudam por aqui. O e-mail serve para contato com o suporte.</p>
                <div class="profile-grid">
                    <div><span class="profile-label">Usuário</span><span c-id="username" class="profile-value">…</span></div>
                    <div><span class="profile-label">Papel</span><span><span c-id="role" class="account-status">…</span></span></div>
                    <div><span class="profile-label">Conta</span><span class="profile-value"><span c-id="account">…</span> <span c-id="account-status" class="account-status none"></span></span></div>
                    <div><span class="profile-label">Usuário criado em</span><span c-id="created" class="profile-value">…</span></div>
                    <div><span class="profile-label">Senha alterada em</span><span c-id="password-changed" class="profile-value">…</span></div>
                </div>
                <div class="mt-3">
                    <label class="form-label">E-mail</label>
                    <input c-id="email" type="email" class="form-control" placeholder="voce@empresa.com" autocomplete="email">
                </div>
                <div class="profile-actions">
                    <div c-id="loading-profile" class="spinner-border none" role="status"><span class="visually-hidden">Salvando...</span></div>
                    <button c-id="save-profile" class="btn-modal">Salvar dados</button>
                </div>
            </section>
        </div>

        <div class="col-lg-6 col-xl-5">
            <section class="modal-section profile-section">
                <h6 class="modal-section-title"><i class="bi bi-key"></i> Alterar senha</h6>
                <p class="modal-section-hint">Mínimo de 8 caracteres. Esta sessão continua aberta; outras sessões suas seguem válidas até expirarem.</p>
                <form c-id="password-form" autocomplete="off">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Senha atual</label>
                            <div class="password-field">
                                <input c-id="current_password" type="password" class="form-control" autocomplete="current-password">
                                <button type="button" class="password-toggle" c-id="toggle-password" title="Mostrar ou ocultar"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nova senha</label>
                            <div class="password-field">
                                <input c-id="password" type="password" class="form-control" autocomplete="new-password" minlength="8">
                                <button type="button" class="password-toggle" c-id="toggle-password" title="Mostrar ou ocultar"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirmar nova senha</label>
                            <div class="password-field">
                                <input c-id="password_confirm" type="password" class="form-control" autocomplete="new-password" minlength="8">
                                <button type="button" class="password-toggle" c-id="toggle-password" title="Mostrar ou ocultar"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="profile-actions">
                        <div c-id="loading-password" class="spinner-border none" role="status"><span class="visually-hidden">Salvando...</span></div>
                        <button type="submit" c-id="save-password" class="btn-modal">Alterar senha</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>
