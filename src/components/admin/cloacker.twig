<br>
<br>
<div class="mx-5 mt-5 mb-4">
    <div class="d-flex justify-content-between">
        <h5>White list <i class="bi bi-pc-display-horizontal"></i></h5>
        <button c-id="new-ip" class="btn-add-product">Adicionar ip</button>
    </div>
    
    <div class="my-table mt-3">
        <div class="row mx-1 p-1">
            <div class="col-lg-4">
                <label class="mt-1"><b>Ip</b></label>
            </div>
            <div class="col-lg-4">
                <label class="mt-1"><b>Data de Cadastro</b></label>
            </div>
            <div class="col-lg-4">
                <label class="mt-1"><b>Ações</b></label>
            </div>
        </div>

        <div c-id="model-ip" id="" class="col-lg-12 none">
            <div  class="row model-table p-2">
                <div class="col-lg-4">
                    
                    <a c-id="ip" class="ms-2"></a>
                </div>
                <div class="col-lg-4">
                    <a c-id="createdAt" class="ms-2"></a>
                </div>
                <div class="col-lg-4"><div class="row-actions"><button c-id="btn-delete" class="btn-delete" title="Excluir IP"><i class="bi bi-trash3"></i></button></div></div>
            </div>
        </div>

        <div c-id="all-ip" class="row">
            {% for ip in ips %}

                <div c-id="model-ip" id="{{ip._id}}" class="col-lg-12">
                    <div  class="row model-table p-2">
                        <div class="col-lg-4">
                            <a class="ms-2">{{ip.ip}}</a>
                        </div>
                        <div class="col-lg-4">
                            <a c-id="createdAt" class="ms-2">{{ip.createdAt}}</a>
                        </div>
                        <div class="col-lg-4"><div class="row-actions"><button c-id="btn-delete" class="btn-delete" title="Excluir IP"><i class="bi bi-trash3"></i></button></div></div>
                    </div>
                </div>

                            
            {% endfor %}
        </div>
    </div>
    
</div>



<div c-id="modal-ip" class="modal fade" tabindex="-1" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-dialog-centered">
    <div c-id="form" class="modal-content bk-modal">
      <div class="modal-header rm-border">
        <div class="container-fluid px-3">
            <h1 class="modal-title fs-5"><i class="bi bi-shield-lock me-1"></i>Novo IP na white list</h1>
            <p class="modal-subtitle">IPs da equipe passam direto pelo filtro e não entram nas métricas.</p>
        </div>
        <button c-id="close-modal" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body">
        <section class="modal-section mb-0">
            <label class="form-label">IP</label>
            <input c-id="ip" type="text" class="form-control" placeholder="177.55.228.202">
        </section>
      </div>
      <div class="modal-footer rm-border">
        <div c-id="loading-btn" class="spinner-border none" role="status"><span class="visually-hidden">Loading...</span></div>
        <button c-id="save-ip" class="btn-modal">Salvar</button>
      </div>
    </div>
  </div>
</div>
