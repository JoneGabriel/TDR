<br>
<br>
<div class="mx-5 mt-5 mb-4">
    <div class="d-flex justify-content-between">
        <h5>Produtos <i class="bi bi-tag"></i></h5>
        <div>
            <button c-id="refresh-prices" class="btn-modal me-2" title="Busca na Shopify os preços por país de todos os produtos">Atualizar preços</button>
            <button c-id="new-product" class="btn-add-product">Adicionar produto</button>
        </div>
    </div>
    
    <div class="my-table mt-3">
        <div class="row mx-1 p-1">
            <div class="col-lg-3">
                <label class="mt-1"><b>Produto</b></label>
            </div>
            <div class="col-lg-2">
                <label class="mt-1"><b>Coleção</b></label>
            </div>
            <div class="col-lg-2">
                <label class="mt-1"><b>Preço</b></label>
            </div>
            <div class="col-lg-2">
                <label class="mt-1"><b>Status</b></label>
            </div>
            <div class="col-lg-3">
                <label class="mt-1"><b>Link</b></label>
            </div>
        </div>

        <div c-id="model-product" id="" class="col-lg-12 none">
            <div  class="row model-table p-2">
                <div class="col-lg-3">
                    <img class="ms-2" src=""> 
                    <a class="ms-2"></a>
                </div>
                <div class="col-lg-2">
                    <label c-id="collection-product" class="ms-2"></label>
                </div>
                <div class="col-lg-2">
                    <label c-id="price" class="ms-2"></label>
                </div>
                <div class="col-lg-2">
                    <div class="form-check form-switch">
                        <input c-id="status" class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked">
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="row-actions"><button c-id="btn-link" class="btn-add-product">Copiar link</button><button c-id="btn-delete" class="btn-delete" title="Excluir produto"><i class="bi bi-trash3"></i></button></div>
                </div>
            </div>
        </div>

        <div c-id="all-products" class="row">
            {% for produto in products_ %}

                <div c-id="model-product" id="{{produto._id}}" class="col-lg-12">
                    <div  class="row model-table p-2">
                        <div class="col-lg-3">
                            <img class="ms-2" src="{{produto.images[0].base64 |default('https://gravitec.net/pt/empty.jpg')}}"> 
                            <a class="ms-2">{{produto.name}}</a>
                        </div>
                        <div class="col-lg-2">
                            <label c-id="collection-product" class="ms-2">{{produto.collection_.name}}</label>
                        </div>
                        <div class="col-lg-2">
                            <label c-id="price" class="ms-2">{{produto.price}} {{produto.currency_symbol}}</label>
                        </div>
                        <div class="col-lg-2">
                            <div class="form-check form-switch">
                                <input c-id="status" class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked" 
                                {% if produto.status == true %}
                                    checked
                                {% endif %}
                                
                                >
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="row-actions"><button c-id="btn-link" class="btn-add-product">Copiar link</button><button c-id="btn-delete" class="btn-delete" title="Excluir produto"><i class="bi bi-trash3"></i></button></div>
                        </div>
                    </div>
                </div>

                            
            {% endfor %}
        </div>
    </div>
    
</div>

<div class="d-flex justify-content-center z-index-spinner">
    <div c-id="loading-center" class="spinner-border style-spinner none" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>


<div c-id="modal-product" class="modal fade modal-product-style" tabindex="-1" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-fullscreen">
    <div c-id="form" class="modal-content bk-modal">
      <div class="modal-header rm-border">
        <div class="container-fluid px-3">
            <h1 class="modal-title fs-5"><i class="bi bi-box-seam me-1"></i><b c-id="name-product"></b><span class="modal-title-fallback">Novo produto</span></h1>
            <p class="modal-subtitle">Versão first (visitante liberado). A versão second, vista pelo visitante filtrado, fica no fim da página.</p>
        </div>
        <button c-id="close-modal" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body">
        <div class="container-xl">
            <div class="row g-3">
                <div class="col-lg-8">
                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-info-circle"></i> Informações</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Título</label>
                                <input c-id="name" type="text" class="form-control" placeholder="Camiseta de manga curta">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Coleção</label>
                                <select c-id="collection" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Loja</label>
                                <select c-id="store-config" class="form-select"></select>
                            </div>
                        </div>
                    </section>

                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-tag"></i> Preços <span c-id="discount-preview" class="chip chip-cyan none"></span></h6>
                        <p class="modal-section-hint">Na moeda base da loja escolhida acima (ou da loja da coleção). Os preços por país vêm da Shopify ao salvar e pelo botão "Atualizar preços".</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Comparação de preços</label>
                                <div class="input-group currency-group"><span class="input-group-text is-unknown" c-id="currency-symbol" title="Escolha a loja ou a coleção para ver a moeda base">¤</span><input c-id="last_price" type="number" step="0.01" class="form-control" placeholder="0,00"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Preço</label>
                                <div class="input-group currency-group"><span class="input-group-text is-unknown" c-id="currency-symbol" title="Escolha a loja ou a coleção para ver a moeda base">¤</span><input c-id="price" type="number" step="0.01" class="form-control" placeholder="0,00"></div>
                            </div>
                        </div>
                    </section>

                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-images"></i> Fotos <span c-id="media-count" class="chip">0</span></h6>
                        <p class="modal-section-hint">Arraste as miniaturas para reordenar: a primeira é a capa nas listagens. Clique duas vezes (ou no ícone) para ver em tamanho real. As imagens são redimensionadas no navegador para até 1600px.</p>
                        <div class="media-field">
                            <label class="dropzone" c-id="dropzone-images">
                                <input multiple="multiple" c-id="images" type="file" accept="image/*" class="dropzone-input">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <span class="dropzone-title">Arraste as fotos aqui ou clique para escolher</span>
                                <span class="dropzone-hint">JPG, PNG, WEBP ou GIF · várias de uma vez</span>
                            </label>
                            <div class="model-img none" c-id="model-img" draggable="true">
                                <img alt="">
                                <span class="media-cover">Capa</span>
                                <span class="media-meta"></span>
                                <div class="media-actions">
                                    <button type="button" c-id="view-img" title="Ver em tamanho real"><i class="bi bi-arrows-fullscreen"></i></button>
                                    <button type="button" c-id="set-cover" title="Definir como capa"><i class="bi bi-star"></i></button>
                                    <button type="button" c-id="remove-img" title="Remover"><i class="bi bi-trash3"></i></button>
                                </div>
                            </div>
                            <div c-id="image-list" class="media-grid"></div>
                        </div>
                    </section>

                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-text-paragraph"></i> Descrição</h6>
                        <textarea id="description" c-id="description"></textarea>
                    </section>

                    <section class="modal-section">
                        <h6 class="modal-section-title"><i class="bi bi-boxes"></i> Bundles <button c-id="new-bundle" class="btn-modal ms-auto">Adicionar bundle</button></h6>
                        <p class="modal-section-hint">Preço manual na moeda base, aplicado no checkout pelo cupom da Shopify. Use cupons percentuais para bater em outras moedas.</p>
                        <div c-id="model-bundle" class="bundle-card none">
                            <div class="bundle-card-head">
                                <label class="form-check mb-0">
                                    <input class="form-check-input" type="radio" name="bundle" c-id="default_bundle">
                                    <span class="form-check-label">Bundle padrão</span>
                                </label>
                                <i c-id="remove-bundle" class="bi bi-x-circle-fill" title="Remover bundle"></i>
                            </div>
                            <div class="bundle-fields">
                                <div><label class="form-label">Título</label><input class="form-control" c-id="title_bundle"></div>
                                <div><label class="form-label">Comparação de preços</label><div class="input-group currency-group"><span class="input-group-text is-unknown" c-id="currency-symbol" title="Escolha a loja ou a coleção para ver a moeda base">¤</span><input class="form-control" c-id="last_price_bundle" type="number" step="0.01"></div></div>
                                <div><label class="form-label">Preço</label><div class="input-group currency-group"><span class="input-group-text is-unknown" c-id="currency-symbol" title="Escolha a loja ou a coleção para ver a moeda base">¤</span><input class="form-control" c-id="price_bundle" type="number" step="0.01"></div></div>
                                <div><label class="form-label">Quantidade</label><input class="form-control" c-id="amount" type="number" min="1"></div>
                                <div><label class="form-label">Cupom Shopify</label><input class="form-control" c-id="cupom_code" type="text"></div>
                            </div>
                        </div>
                        <div c-id="all-bundles"></div>
                    </section>
                </div>

                <div class="col-lg-4">
                    <section class="modal-section modal-section-sticky">
                        <h6 class="modal-section-title"><i class="bi bi-shop"></i> Shopify</h6>
                        <p class="modal-section-hint">Loja Shopify do produto e o ID dele lá. Variantes e preços por país vêm daqui.</p>
                        <label class="form-label">Adicionar Shopify</label>
                        <div class="d-flex gap-2">
                            <select class="form-select" c-id="stores"></select>
                            <button c-id="add-store" class="btn btn-info" title="Adicionar"><i class="bi bi-plus-lg"></i></button>
                        </div>
                        <div c-id="model-store" class="shop-card none">
                            <div class="shop-card-head">
                                <span class="shop-card-url"><i class="bi bi-shop"></i> <b c-id="url"></b></span>
                                <i c-id="remove-store" class="bi bi-x-circle-fill" title="Remover Shopify"></i>
                            </div>
                            <label class="form-label">ID do produto nessa Shopify</label>
                            <input placeholder="ex.: 15560251736145" c-id="id_shopify_store" class="form-control">
                        </div>
                        <div c-id="all-stores" class="mt-3"></div>
                    </section>
                </div>

                <div class="col-12">
                    <section c-id="second-version" class="modal-section modal-section-second">
                        <h6 class="modal-section-title"><i class="bi bi-layers"></i> Versão second (visitante filtrado) <button c-id="copy-first" class="btn-modal ms-auto">Copiar da versão first</button></h6>
                        <p class="modal-section-hint">Exibida com o layout second da loja. Campo vazio usa o valor da versão first. <b>Sem nenhum campo preenchido aqui, o produto não aparece na loja second</b> (coleções, home, página do produto e carrinho).</p>
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label">Título</label>
                                    <input c-id="name_second" type="text" class="form-control">
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Comparação de preços</label>
                                        <div class="input-group currency-group"><span class="input-group-text is-unknown" c-id="currency-symbol" title="Escolha a loja ou a coleção para ver a moeda base">¤</span><input c-id="last_price_second" type="number" step="0.01" class="form-control" placeholder="0,00"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Preço</label>
                                        <div class="input-group currency-group"><span class="input-group-text is-unknown" c-id="currency-symbol" title="Escolha a loja ou a coleção para ver a moeda base">¤</span><input c-id="price_second" type="number" step="0.01" class="form-control" placeholder="0,00"></div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label class="form-label">Fotos <span c-id="media-count-second" class="chip">0</span></label>
                                    <div class="media-field">
                                        <label class="dropzone dropzone-sm" c-id="dropzone-images-second">
                                            <input multiple="multiple" c-id="images-second" type="file" accept="image/*" class="dropzone-input">
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            <span class="dropzone-title">Arraste ou clique para escolher</span>
                                        </label>
                                        <div c-id="image-list-second" class="media-grid"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <label class="form-label">Descrição</label>
                                <textarea id="description_second" c-id="description_second"></textarea>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
      </div>
      <div class="modal-footer rm-border">
        <div c-id="loading-btn" class="spinner-border none" role="status"><span class="visually-hidden">Loading...</span></div>
        <button c-id="save-product" class="btn-modal">Salvar</button>
      </div>
    </div>
  </div>
</div>

<div c-id="modal-link" class="modal fade" tabindex="-1" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bk-modal">
      <div class="modal-header rm-border">
        <h1 class="modal-title fs-5"><i class="bi bi-link-45deg me-1"></i>Links do produto</h1>
        <button c-id="close-modal-link" class="btn-modal">Fechar</button>
      </div>
      <div class="modal-body">
        <p class="modal-section-hint">Um link por domínio ativo. Copie e use nos anúncios.</p>
        <div c-id="model-link" class="link-row none">
            <a target="_blank"></a>
            <button c-id="copy" class="btn-modal">Copiar</button>
        </div>
        <div c-id="all-links" class="link-list"></div>
      </div>
    </div>
  </div>
</div>
