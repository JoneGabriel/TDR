<!DOCTYPE html>
<html lang="pt-br">
{% include './head.twig'%} 
<body data-layout="{{ layout|default('first') }}" data-country="{{ buyer_country|default('') }}" data-currency="{{ currency|default('') }}">
    {% if order_chat is defined and order_chat %}
        <script>window.TDR_ORDER = {{ order_chat|raw }};</script>
    {% endif %}
    {% if store == true %}
        {{ menu_store|raw }}
    {% endif %}

     {% if admin == true %}
   
        {% include './menu-admin.twig'%}
        {% include './confirm-admin.twig'%}
    {% endif %}

        {# vitrine: HTML já renderizado pelo template da loja (uma passagem só, sem reavaliar como Twig) #}
        {% if store == true and policy != true %}
            {{ template|raw }}
        {% endif %}
    {# painel e políticas: arquivo .twig do projeto, informado pelo controller em `view` #}
    {% if view is defined and view %}
        {% include view %}
    {% endif %}
     
    {% if store == true %}
        {{ cart_template|raw }}
    {% endif %}

    {% include './footer.twig'%}
</body>
</html>