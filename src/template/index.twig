<!DOCTYPE html>
<html lang="pt-br">
{% include './head.twig'%} 
<body data-layout="{{ layout|default('first') }}" data-country="{{ buyer_country|default('') }}" data-currency="{{ currency|default('') }}">
    {% if order_chat is defined and order_chat %}
        <script>window.TDR_ORDER = {{ order_chat|raw }};</script>
    {% endif %}
    {% if store == true %}
        {{ menu_store}}
    {% endif %}

     {% if admin == true %}
   
        {% include './menu-admin.twig'%}
        {% include './confirm-admin.twig'%}
    {% endif %}

        {% if store == true and policy !=true %}
            {{ template}}
        {% endif %}
    {% if admin == true or policy == true %}
        {% include (template_from_string(template)) %}
    {% endif %}
     
    {% if store == true %}
        {{cart_template}}
    {% endif %}

    {% include './footer.twig'%}
</body>
</html>